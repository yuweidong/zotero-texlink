{
  "manifest_version": 2,
  "name": "TexLink",
  "version": "0.1.2",
  "description": "离线公式识别与 Zotero 笔记锚定：把 PDF 中的公式截图转成 LaTeX，并连同页码、时间戳写入文献笔记。",
  "author": "Weidong Yu",
  "icons": {
    "48": "chrome/content/icons/texlink-48.png",
    "96": "chrome/content/icons/texlink-96.png"
  },
  "applications": {
    "zotero": {
      "id": "zotero-texlink@yuweidong.dev",
      "strict_min_version": "10.0",
      "strict_max_version": "10.999",
      "update_url": "https://zotero-texlink.invalid/updates.json"
    }
  }
}
